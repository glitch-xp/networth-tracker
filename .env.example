# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth (configured in Supabase dashboard)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gemini AI (used server-side only, never expose to browser)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash
# AI_PROVIDER=gemini

# MacroDroid SMS Ingestion (used server-side only)
# MACRODROID_DEVICE_SECRET=your-device-secret

# Broker (used server-side only)
# BROKER_CLIENT_SECRET=your-broker-secret
